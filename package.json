{
  "name": "chip-design-tutorial",
  "description": "VeriBench — on-device Verilog, FPGA, and ASIC lessons.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node -e \"require('fs').copyFileSync('build/404.html','build/index.html')\"",
    "preview": "vite preview --outDir build",
    "check:req": "./scripts/check-requirements.sh",
    "check:req:wasm": "./scripts/check-requirements.sh --with-wasm",
    "setup:circt": "./scripts/setup-circt.sh",
    "build:circt": "./scripts/build-circt-wasm.sh",
    "bootstrap:repro": "./scripts/bootstrap-repro.sh",
    "local-publish:circt": "./scripts/sync-circt-wasm.sh",
    "publish:circt": "./scripts/sync-circt-wasm.sh --publish",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:install": "npm install --prefix desktop",
    "desktop:dist:linux": "npm run build && npm run desktop:install && npm run dist:linux --prefix desktop",
    "desktop:start": "npm start --prefix desktop"
  },
  "dependencies": {
    "@codemirror/legacy-modes": "^6.5.2",
    "@replit/codemirror-vim": "^6.3.0",
    "@tailwindcss/vite": "^4.2.0",
    "codemirror": "^6.0.2",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.2.0",
    "z3-solver": "^4.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.53.0",
    "compression": "^1.8.1",
    "vite": "^6.0.0",
    "vite-plugin-compression2": "^2.4.0",
    "vitest": "^4.0.18"
  }
}
