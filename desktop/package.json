{
  "name": "veribench-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "VeriBench desktop shell. Serves the static web build on localhost so WASM and the service worker work offline.",
  "main": "main.cjs",
  "author": "Samir Shah Ahmed",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux dir",
    "dist:linux:appimage": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.veribench.app",
    "productName": "VeriBench",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "static-server.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build",
        "to": "web"
      }
    ],
    "linux": {
      "target": ["dir"],
      "category": "Education",
      "icon": "icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icon.png",
      "identity": null
    }
  }
}
